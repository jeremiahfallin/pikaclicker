rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Players whose save doubles as a gym (src/hooks/useGym.js).
    function isGymLeader(uid) {
      return uid in ['CapOlX5zrCUTWsQn5EUwxmca6ha2', 'Dp2FEH1qrlPFSyveiMtgdM9YXFM2'];
    }

    // Shared save codes, keyed by three Pokemon names (src/hooks/useSave.js).
    // Any signed-in player can load any code. The first player to save to a
    // code owns it and is the only one who can overwrite it. Codes saved before
    // owners existed stay readable but locked.
    match /saves/{code} {
      function validSave() {
        let d = request.resource.data;
        return d.keys().hasOnly(['data', 'owner'])
          && d.data is string
          && d.owner == request.auth.uid;
      }

      allow read: if signedIn();
      allow create: if signedIn() && validSave();
      allow update: if signedIn()
        && resource.data.get('owner', null) == request.auth.uid
        && validSave();
      allow delete: if false;
    }

    // Each player's cloud save lives at /{uid}/{uid} (src/hooks/useAuth.js).
    // Only the player can read or write their collection, except that gym
    // leaders' save docs are readable by every signed-in player.
    match /{uid}/{docId} {
      allow read: if signedIn() && uid != 'saves' && (
        request.auth.uid == uid
        || (isGymLeader(uid) && docId == uid)
      );
      allow write: if signedIn() && uid != 'saves' && request.auth.uid == uid;
    }
  }
}
